# Copy to .env next to docker-compose.yml and fill in the values.

# --- Required ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL users open in the browser (no trailing slash).
# Use https in production: passkeys and secure cookies need it. (your domain + port name (if you use port other than 443))
BETTER_AUTH_URL=https://21-day.example.com
# Optional: WebAuthn relying-party id (defaults to the hostname of BETTER_AUTH_URL)
# PASSKEY_RP_ID=

# Strong password for the CouchDB admin user (internal to the stack)
COUCHDB_URL=http://couchdb:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=
COUCHDB_DB=challenge_tracker

# SMTP (e.g. Purelymail: smtp.purelymail.com, port 465 secure or 587 STARTTLS)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=21-day Coach

NTFY_DEFAULT_SERVER=https://ntfy.sh

# Set HTTPS_PORT only if you want to host on a port other than 443 (leave empty for 443)
HTTPS_PORT=
ACME_EMAIL=
DESEC_API_KEY=
APP_DOMAIN=
APP_UPSTREAM=
