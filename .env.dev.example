# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
# Optional: WebAuthn relying-party id (defaults to the hostname of BETTER_AUTH_URL)
# PASSKEY_RP_ID=

# --- SQLite (auth database) ---
DATABASE_PATH=./data/auth.db

# --- CouchDB (progress data) ---
# Start the dev container with: pnpm couch:up
COUCHDB_URL=http://localhost:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=changeme
COUCHDB_DB=challenge_tracker

# --- SMTP ---
# Defaults point at the dev Mailpit container (pnpm couch:up); read mail at http://localhost:8025.
# For a real provider (e.g. Purelymail: smtp.purelymail.com, port 465 secure or 587 STARTTLS),
# set SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, and SMTP_PASS. Leave SMTP_HOST empty to disable email.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=21-day Coach

# --- ntfy ---
NTFY_DEFAULT_SERVER=https://ntfy.sh
